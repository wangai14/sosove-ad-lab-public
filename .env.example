# Runtime data and local material vault
SEEDANCE_RUNTIME_DIR=.runtime
SEEDANCE_OBSIDIAN_MATERIAL_ROOT=./material-vault
SEEDANCE_AUTH_USERNAME=admin
SEEDANCE_AUTH_PASSWORD=replace-with-a-long-random-password
SEEDANCE_AUTH_SECURE_COOKIE=0

